# Copy this file to `.env` and fill in your own values.
# .env is git-ignored — never commit real credentials.
#
# These come from an Azure AD (Microsoft Entra ID) App Registration with
# read-only Graph permissions: Policy.Read.All (Application or Delegated).

AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-app-registration-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
